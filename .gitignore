# Environment and Secrets
.env

# Data directories (Large files)
data/raw/
data/clean/
!data/clean/.gitkeep

# Analysis Artifacts
# We ignore the heavy CSVs but keep the dashboard JSON/GeoJSON if needed for GitHub Pages
# If you prefer to ignore all artifacts, uncomment the next line:
# artifacts/
artifacts/*.csv
artifacts/*.xlsx

# Dashboard dynamic data (optional: ignore if generated by CI)
# artifacts/*.json
# artifacts/*.geojson

# Cache and Temporary files
TEMP/
logs/
.pytest_cache/
__pycache__/
*.py[cod]
utils/geocode_cache.json

# System files
.DS_Store
Thmubs.db
